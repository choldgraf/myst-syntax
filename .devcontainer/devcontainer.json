// GitHub Codespaces: VS Code with the MyST Syntax extension, opened on demo/index.md.
{
  "name": "myst-syntax",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "postCreateCommand": "npm ci && npm run package -w packages/vscode",
  // The `code` command only works once VS Code has attached, so install the extension here rather than in postCreateCommand.
  "postAttachCommand": "code --install-extension packages/vscode/myst-syntax.vsix",
  "customizations": {
    "codespaces": { "openFiles": ["demo/index.md"] }
  }
}
