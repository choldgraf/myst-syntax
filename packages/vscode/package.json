{
  "name": "myst-syntax-vscode",
  "displayName": "MyST Syntax",
  "description": "Highlights MyST Markdown syntax on top of VS Code's Markdown highlighting",
  "version": "0.0.1",
  "publisher": "myst-author",
  "private": true,
  "license": "CC0-1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choldgraf/myst-syntax.git",
    "directory": "packages/vscode"
  },
  "contributes": {
    "grammars": [
      {
        "scopeName": "text.myst.injection",
        "path": "./myst.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ]
  },
  "scripts": {
    "build": "cp ../syntax/myst.tmLanguage.json ../../LICENSE .",
    "package": "npm run build && vsce package --no-dependencies -o myst-syntax.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "myst-syntax": "*"
  }
}
