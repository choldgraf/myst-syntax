        },
        "2": {
          "name": "entity.other.attribute-name.myst"
        },
        "3": {
          "name": "punctuation.definition.option.myst"
        }
      }
    },
    "role": {
      "match": "(\\{)([\\w:.+-]+)(\\})(?=`)",
      "captures": {
        "1": {
          "name": "punctuation.definition.role.myst"
        },
        "2": {
          "name": "entity.name.function.role.myst"
        },
        "3": {
          "name": "punctuation.definition.role.myst"
        }
      }
    },
    "target": {
      "comment": "Label characters follow mystmd's TARGET_PATTERN (markdown-it-myst).",
      "match": "(?:^|\\G)\\s*(\\()([a-zA-Z0-9|@<>*./_\\-+:]+)(\\))(=)\\s*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.target.myst"
        },
        "2": {
          "name": "string.other.link.label.myst"
        },
        "3": {
          "name": "punctuation.definition.target.myst"
        },
        "4": {
          "name": "punctuation.definition.target.myst"
        }
      }
    },
    "display-math": {
      "comment": "Like mystmd's dollarmath. It runs from a line starting with $$ to a line ending with $$, or $$ (label). A blank line ends it, as it does in mystmd.",
      "begin": "(?:^|\\G) {0,3}(\\$\\$)",
      "end": "(\\$\\$)(?:\\s*\\([^)$]+\\))?\\s*$|^(?=\\s*$)",
      "contentName": "string.other.math.block.myst",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.math.myst"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.math.myst"
        }
      }
    },
    "math": {
      "comment": "Like patterns.math in src/codemirror.ts.",
      "match": "(?<![\\\\$])(\\$)([^$]+)(\\$)(?!\\$)",
      "captures": {
        "1": {
          "name": "punctuation.definition.math.myst"
        },
        "2": {
          "name": "string.other.math.inline.myst"
        },
        "3": {
          "name": "punctuation.definition.math.myst"
        }
      }
    },
    "citation": {
      "comment": "Like patterns.citation in src/codemirror.ts.",
      "match": "(?<![\\w@])(@)(\\w(?:[\\w:.#$%&\\-+?~/]*\\w)?)",
      "captures": {
        "1": {
          "name": "punctuation.definition.citation.myst"
        },
        "2": {
          "name": "string.other.link.citation.myst"
        }
      }
    },
    "block-break": {
      "match": "(?:^|\\G) {0,3}(\\+\\+\\+.*)$",
      "captures": {
        "1": {
          "name": "meta.separator.myst"
        }
      }
    },
    "comment": {
      "match": "(?:^|\\G) {0,3}(%.*)$",
      "captures": {
        "1": {
          "name": "comment.line.percentage.myst"
        }
      }
    },
    "yaml-options": {
      "begin": "(?:^|\\G)\\s*---\\s*$",
      "end": "(?:^|\\G)\\s*---\\s*$|(?=(?:^|\\G)\\s*:{3,}\\s*$)",
      "contentName": "meta.embedded.block.yaml",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.options.myst"
        }
      },
      "endCaptures": {
